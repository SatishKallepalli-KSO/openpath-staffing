# Public app URL
APP_URL=http://localhost:5175

# JWT signing secret (required in production; local default is fine)
JWT_SECRET=dev-openpath-jwt-secret-change-me

# Admin desk PIN (8+ chars). Set on Render. Local fallback only with ALLOW_INSECURE_DEFAULT_PIN=1
ADMIN_PIN=

# Local-only fallback if ADMIN_PIN is empty (never set on Render)
# ALLOW_INSECURE_DEFAULT_PIN=1

# Comma-separated CORS origins (default *). For split hosting set explicit origins.
# CORS_ORIGINS=https://openpath-staffing.onrender.com

# Postgres — Neon Free pooled URL in production (see docs/DATABASE.md)
# Omit for local SQLite under apps/api/data/openpath.db
# DATABASE_URL=postgresql://openpath:PASS@ep-xxxx-pooler.region.aws.neon.tech/openpath?sslmode=require

# Optional live US job search (https://developer.adzuna.com)
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us
